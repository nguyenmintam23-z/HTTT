@startuml 07_ERD_ThucTheLienKet
!theme plain
skinparam linetype ortho
skinparam roundcorner 5
skinparam shadowing false
skinparam class {
    BackgroundColor white
    ArrowColor #2b5797
    BorderColor #2b5797
}

entity "chuc_vu" as chuc_vu {
    * **ten_chuc_vu** : VARCHAR(50) [PK]
}

entity "nguoi_dung" as nguoi_dung {
    * **username** : VARCHAR(50) [PK]
    --
    * password : VARCHAR(255)
    * role : VARCHAR(20) [CHECK: staff, manager, admin]
    ho_ten : VARCHAR(100)
    # chuc_vu : VARCHAR(50) [FK -> chuc_vu]
}

entity "nha_cung_cap" as nha_cung_cap {
    * **ma_ncc** : VARCHAR(20) [PK]
    --
    * ten_ncc : VARCHAR(100)
    dia_chi : VARCHAR(200)
    so_dien_thoai : VARCHAR(20)
    email : VARCHAR(100)
}

entity "sach" as sach {
    * **ma_sach** : VARCHAR(20) [PK]
    --
    * ten_sach : VARCHAR(150)
    the_loai : VARCHAR(50)
    tac_gia : VARCHAR(100)
    nha_xuat_ban : VARCHAR(100)
    # **ma_ncc** : VARCHAR(20) [FK -> nha_cung_cap]
    * gia_nhap : DECIMAL(15,2)
    * gia_ban : DECIMAL(15,2)
    * so_luong_ton : INTEGER
    vi_tri : VARCHAR(50)
}

entity "phieu_nhap" as phieu_nhap {
    * **ma_phieu_nhap** : VARCHAR(20) [PK]
    --
    * ngay_nhap : DATE
    # **ma_ncc** : VARCHAR(20) [FK -> nha_cung_cap]
    # nguoi_lap : VARCHAR(50) [FK -> nguoi_dung]
    * tong_tien : DECIMAL(15,2)
}

entity "chi_tiet_phieu_nhap" as chi_tiet_phieu_nhap {
    * **id** : INTEGER [PK, AUTO]
    --
    # **ma_phieu_nhap** : VARCHAR(20) [FK -> phieu_nhap, CASCADE]
    # **ma_sach** : VARCHAR(20) [FK -> sach, RESTRICT]
    * so_luong_nhap : INTEGER
    * don_gia_nhap : DECIMAL(15,2)
    * thanh_tien : DECIMAL(15,2)
}

entity "phieu_xuat" as phieu_xuat {
    * **ma_phieu_xuat** : VARCHAR(20) [PK]
    --
    * ngay_xuat : DATE
    nguoi_nhan : VARCHAR(100)
    ly_do : VARCHAR(200)
    # nguoi_lap : VARCHAR(50) [FK -> nguoi_dung]
}

entity "chi_tiet_phieu_xuat" as chi_tiet_phieu_xuat {
    * **id** : INTEGER [PK, AUTO]
    --
    # **ma_phieu_xuat** : VARCHAR(20) [FK -> phieu_xuat, CASCADE]
    # **ma_sach** : VARCHAR(20) [FK -> sach, RESTRICT]
    * so_luong_xuat : INTEGER
}

' Mối quan hệ giữa các thực thể
chuc_vu ||--o{ nguoi_dung : "gán cho (1:N)"
nguoi_dung ||--o{ phieu_nhap : "lập phiếu (1:N)"
nguoi_dung ||--o{ phieu_xuat : "lập phiếu (1:N)"
nha_cung_cap ||--o{ sach : "cung cấp (1:N)"
nha_cung_cap ||--o{ phieu_nhap : "giao hàng (1:N)"
phieu_nhap ||--|{ chi_tiet_phieu_nhap : "chứa (1:N)"
sach ||--o{ chi_tiet_phieu_nhap : "được nhập (1:N)"
phieu_xuat ||--|{ chi_tiet_phieu_xuat : "chứa (1:N)"
sach ||--o{ chi_tiet_phieu_xuat : "được xuất (1:N)"

@enduml
