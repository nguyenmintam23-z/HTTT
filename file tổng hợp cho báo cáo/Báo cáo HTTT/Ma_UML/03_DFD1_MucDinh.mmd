flowchart TD
    %% Tác nhân
    Admin["Quản trị viên"]
    NVKho["Nhân viên kho"]
    QLKho["Quản lý kho"]

    %% Tiến trình
    P1(("1.0<br>Đăng nhập &<br>Quản lý User"))
    P2(("2.0<br>Quản lý Danh mục<br>& Đối tác"))
    P3(("3.0<br>Quản lý<br>Nhập - Xuất kho"))
    P4(("4.0<br>Báo cáo &<br>Thống kê kho"))

    %% Kho dữ liệu
    D1[("D1: NHANVIEN")]
    D2[("D2: SACH")]
    D3[("D3: NHACUNGCAP")]
    D4[("D4: PHIEUNHAP & CT")]
    D5[("D5: PHIEUXUAT & CT")]

    %% Luồng P1 (Admin)
    Admin -->|Thông tin User, phân quyền| P1
    P1 -->|Danh sách User, trạng thái| Admin
    P1 <-->|Đọc/Ghi dữ liệu User| D1

    %% Luồng P2 (B4)
    QLKho -->|Thêm/Sửa/Xóa Sách, NCC| P2
    P2 -->|Danh sách Sách, NCC| QLKho
